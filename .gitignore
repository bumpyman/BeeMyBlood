# ========================
# BeeMyBlood – .gitignore
# ========================

# Server logs (Infomaniak)
ik-logs/
*.log
*.log-*
*.gz

# Environment & API keys
.env
.env.*
*.key

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Node (if used later)
node_modules/
package-lock.json

# Build artifacts
dist/
build/

# BeeMyBlood server config (API key) — never commit
config.php
beemyblood_project/sites/beemyblood.ch/config.php

# cache du endpoint de données (créé par PHP)
beemyblood_project/sites/beemyblood.ch/api/cache/
